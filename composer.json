{
    "name": "team-nifty-gmbh/nuxbe-remote-directory",
    "description": "Serves Flux ERP contacts as a remote directory for phone clients (XML phonebook, searchable by name, company or number).",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://team-nifty.com",
    "authors": [
        {
            "name": "Patrick Weh",
            "email": "pw@team-nifty.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "team-nifty-gmbh/flux-erp": "^1.0 || dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NuxbeRemoteDirectory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NuxbeRemoteDirectory\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NuxbeRemoteDirectory\\NuxbeRemoteDirectoryServiceProvider"
            ]
        },
        "testbench": {
            "providers": [
                "Spatie\\LaravelTranslatable\\TranslatableServiceProvider",
                "Spatie\\Permission\\PermissionServiceProvider",
                "Spatie\\Activitylog\\ActivitylogServiceProvider",
                "Spatie\\MediaLibrary\\MediaLibraryServiceProvider",
                "Spatie\\Tags\\TagsServiceProvider",
                "Spatie\\ModelStates\\ModelStatesServiceProvider",
                "Livewire\\LivewireServiceProvider",
                "Laravel\\Sanctum\\SanctumServiceProvider",
                "TallStackUi\\TallStackUiServiceProvider",
                "FluxErp\\FluxServiceProvider",
                "NuxbeRemoteDirectory\\NuxbeRemoteDirectoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
